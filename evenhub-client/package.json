{
  "name": "ocuclaw-inbox-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16 -o ocuclaw-inbox.ehpk",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@fontsource/noto-sans": "5.2.10",
    "dompurify": "3.4.17",
    "marked": "18.0.7"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
